---
import { getEmDashCollection } from "emdash";
import Base from "@/layouts/Base.astro";
import { Intro } from "@/components/Intro";
import { PostList } from "@/components/PostList";
import { toSummary } from "@/lib/posts";
import { homeSchema } from "@/lib/structured-data";

const { entries, error, cacheHint } = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
  limit: 10,
});
if (error) {
  console.error("Failed to load posts:", error);
  return new Response("Unable to load posts", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const posts = entries.map(toSummary);
---

<Base title="Home" schema={homeSchema()}>
  <Intro />

  <section class="mt-24">
    <h2 class="mb-4 text-3xl">Recent Posts</h2>
    <PostList posts={posts} />
  </section>

  <a class="mx-auto mt-16 inline-block w-fit text-lg text-current" href="/blog">View All Posts</a>
</Base>

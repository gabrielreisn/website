---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "@/layouts/Base.astro";
import { site } from "@/lib/site";
import { imageUrl } from "@/lib/posts";
import { aboutSchema } from "@/lib/structured-data";

// Content lives in EmDash: Pages → "about".
const { entry: page, error, cacheHint } = await getEmDashEntry("pages", "about");
if (error) {
  console.error("Failed to load about page:", error);
  return new Response("Unable to load page", { status: 500 });
}
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
  siteUrl: site.url,
  path: "/about",
  defaultOgImage: new URL(imageUrl(page.data.image) ?? site.defaultSocialImage, site.url).href,
});
---

<Base
  title={seo.title}
  description={seo.description}
  image={seo.ogImage}
  canonical={seo.canonical}
  robots={seo.robots}
  content={{ collection: "pages", id: page.data.id, slug: "about" }}
  schema={aboutSchema({
    url: seo.canonical ?? "/about",
    name: seo.title ?? page.data.title,
    description: seo.description,
    image: imageUrl(page.data.image),
    datePublished: page.data.publishedAt?.toISOString() ?? null,
    dateModified: page.data.updatedAt.toISOString(),
  })}
>
  <div>
    <h1 class="mb-8" {...page.edit.title}>{page.data.title}</h1>
    {
      page.data.image && (
        <div class="mx-auto mt-4 w-full max-w-80 overflow-hidden rounded-full border-4 border-black/70 min-[575px]:float-right min-[575px]:mt-2 min-[575px]:ml-4 min-[575px]:w-80 [&_img]:mt-0">
          <Image image={page.data.image} width={320} height={320} />
        </div>
      )
    }
    <div class="content [&>p:first-child]:mt-0">
      <PortableText value={page.data.content} />
    </div>
  </div>
</Base>

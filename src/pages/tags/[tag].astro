---
import { decodeSlug, getEmDashCollection, getTerm } from "emdash";
import Base from "@/layouts/Base.astro";
import { PostList } from "@/components/PostList";
import { toSummary } from "@/lib/posts";
import { tagSchema } from "@/lib/structured-data";

const slug = decodeSlug(Astro.params.tag);
const tag = slug ? await getTerm("tag", slug) : null;
if (!tag) return Astro.rewrite("/404");

const { entries, error, cacheHint } = await getEmDashCollection("posts", {
  where: { tag: tag.slug },
  orderBy: { published_at: "desc" },
  limit: 100,
});
if (error) {
  console.error("Failed to load posts:", error);
  return new Response("Unable to load posts", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const posts = entries.map(toSummary);
const description = `Posts tagged #${tag.label}`;
---

<Base title={tag.label} description={description} schema={tagSchema({ slug: tag.slug, label: tag.label, description, posts })}>
  <h1>{tag.label}</h1>
  <PostList posts={posts} />
</Base>

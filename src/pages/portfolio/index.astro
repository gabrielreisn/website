---
import { getEmDashCollection } from "emdash";
import Base from "@/layouts/Base.astro";
import { ProjectList } from "@/components/ProjectList";
import { groupByKind, sortProjects, toProjectSummary } from "@/lib/posts";

const projectsResult = await getEmDashCollection("projects", { orderBy: { published_at: "desc" }, limit: 100 });
if (projectsResult.error) {
  console.error("Failed to load projects:", projectsResult.error);
  return new Response("Unable to load projects", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(projectsResult.cacheHint);

const groups = groupByKind(sortProjects(projectsResult.entries).map(toProjectSummary));
---

<Base title="Portfolio" description="Things I've built, and what I learned building them.">
  <h1>Portfolio</h1>
  <p class="mt-4 mb-12 text-2xl">Things I've built, and what I learned building them.</p>
  {groups.length === 0 && <ProjectList projects={[]} />}
  {
    groups.map((group, i) => (
      <section class:list={[i > 0 && "mt-16"]}>
        {group.heading && <h2 class="mb-4 text-3xl">{group.heading}</h2>}
        <ProjectList projects={group.projects} />
      </section>
    ))
  }
</Base>

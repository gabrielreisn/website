{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Digital Garden",
    "description": "Posts with tags (mirrors the old Notion database) and portfolio projects",
    "author": "Gabriel Reis"
  },
  "settings": {
    "title": "🌿Digital Garden",
    "tagline": "Notes and reflections about Software Engineering, hobbies and water cooler conversations"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "description": "Blog posts. Slug, publish date and draft/published state are built in.",
      "urlPattern": "/posts/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Portfolio entries shown at /portfolio.",
      "urlPattern": "/portfolio/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text"
        },
        {
          "slug": "role",
          "label": "Role",
          "type": "string"
        },
        {
          "slug": "period",
          "label": "Period",
          "type": "string"
        },
        {
          "slug": "url",
          "label": "Live URL",
          "type": "url"
        },
        {
          "slug": "repository",
          "label": "Repository URL",
          "type": "url"
        },
        {
          "slug": "cover",
          "label": "Cover image",
          "type": "image"
        },
        {
          "slug": "featured",
          "label": "Featured",
          "type": "boolean"
        },
        {
          "slug": "content",
          "label": "Case study",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": [
        "posts"
      ],
      "terms": []
    },
    {
      "name": "stack",
      "label": "Stack",
      "labelSingular": "Technology",
      "hierarchical": false,
      "collections": [
        "projects"
      ],
      "terms": []
    }
  ]
}
